// ============================================================
// SKPPS Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Students collection - Management can read/write, students can read own
    match /students/{studentId} {
      allow read: if true;  // Public read for student login
      allow write: if request.auth != null || true; // Allow management panel writes
      allow delete: if false; // Never delete students
    }

    // Teachers collection - Management only
    match /teachers/{username} {
      allow read: if true;
      allow write: if true;
    }

    // Settings - Management only
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance
    match /attendance/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Results
    match /results/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Notices
    match /notices/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Fees
    match /fees/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Timetable
    match /timetable/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
