rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── READ: Open to everyone (students need to read without login complexity) ──
    // ── WRITE: Requires Anonymous Auth (prevents outside tampering) ──

    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['security_code', 'password']);
    }

    match /students/{studentId} {
      allow read, list: if true;
      allow create, update: if request.auth != null
        && request.resource.data.full_name is string
        && request.resource.data.class is string;
      allow delete: if request.auth != null;
    }

    match /teachers/{teacherId} {
      allow read, list: if true;
      allow create, update: if request.auth != null
        && request.resource.data.full_name is string;
      allow delete: if request.auth != null;
    }

    // ── Block everything else ──
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
